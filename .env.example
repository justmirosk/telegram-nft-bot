TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NFT_CONTRACT_ADDRESS=0x_your_nft_contract_address_here
BNB_RPC_URL=https://bsc-dataseed1.binance.org/
NFT_TOTAL_SUPPLY=10000

# Optional announcement publishing (disabled by default)
PUBLISH_ENABLED=false
# Generate a random secret of at least 32 characters; never commit it.
PUBLISH_API_KEY=
# Friendly destination aliases, numeric group IDs, optional forum topic IDs.
PUBLISH_DESTINATIONS={"nft-frens":{"chat_id":"-1001234567890"}}
# Mount a persistent Railway volume here before enabling publishing.
PUBLISH_STATE_DIR=/data/publisher
# Railway supplies PORT automatically.

# Optional exact browser Origin allowlist for MCP; leave empty for server-to-server.
PUBLISH_ALLOWED_ORIGINS=

# Optional browser-compatible OAuth. Disabled until GitHub app credentials exist.
PUBLISH_OAUTH_ENABLED=false
PUBLISH_PUBLIC_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Permanent numeric GitHub user ID allowed to connect (not a username).
PUBLISH_GITHUB_USER_ID=

# Optional Boss Raid rehearsal. Scope it to a private test group.
# Rehearsal award records are mock and the evidence adapter only reads BeaniScrolls Preview.
BOSS_RAID_REHEARSAL_ENABLED=false
BOSS_RAID_TEST_CHAT_ID=
# Leave blank for the main group chat. Set a numeric ID to limit raids to a forum topic.
BOSS_RAID_TEST_TOPIC_ID=
BOSS_RAID_ADMIN_ID=
BOSS_RAID_PREVIEW_LINK_SECRET=
BOSS_RAID_DB_FILE=/data/boss-raid-rehearsal.sqlite
# Optional dedicated RPC for the rehearsal's finalized and historical ownership reads.
BOSS_RAID_BNB_RPC_URL=
# Set only for an authorized one-time mock post. The ID is recorded before sending.
BOSS_RAID_AUTO_LAUNCH_ID=
# Use the bundled mock art, Telegram file IDs for this bot, or HTTPS image URLs.
BOSS_RAID_TEST_TEMPLATE={"name":"Test Beast","beast":"1","hp":600,"lumens":500,"durationMinutes":60,"attacking":"asset:attacking","wounded":"asset:wounded","defeated":"asset:defeated"}

# Optional BeaniScrolls Preview Profile picker and web launch. Match Gems Preview chain and collection.
# Requires the existing private publisher and a BOSS_RAID_BNB_RPC_URL for the matching chain.
BOSS_RAID_USE_PROFILE=false
BOSS_RAID_BNB_CHAIN_ID=
BOSS_RAID_MINIBEANY_CONTRACT=
