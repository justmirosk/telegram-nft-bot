TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NFT_CONTRACT_ADDRESS=0x_your_nft_contract_address_here
BNB_RPC_URL=https://bsc-dataseed1.binance.org/
NFT_TOTAL_SUPPLY=10000

# Optional announcement publishing (disabled by default)
PUBLISH_ENABLED=false
# Generate a random secret of at least 32 characters; never commit it.
PUBLISH_API_KEY=
# Friendly destination aliases, numeric group IDs, optional forum topic IDs.
PUBLISH_DESTINATIONS={"nft-frens":{"chat_id":"-1001234567890"}}
# Mount a persistent Railway volume here before enabling publishing.
PUBLISH_STATE_DIR=/data/publisher
# Railway supplies PORT automatically.
